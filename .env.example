# Telegram Drive — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to the repository.

# --- Telegram API Credentials ---
# Get these from https://my.telegram.org/apps
VITE_TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
VITE_TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH

# --- Supporter Service (Cloudflare Worker) ---
# These are used by supporter-service/wrangler.jsonc and deployment scripts.
# Do NOT put real values here.
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
SUPPORTER_SIGNING_KEY=YOUR_SUPPORTER_SIGNING_KEY

# --- GitHub (for AI agent persistence only — NOT used by the app) ---
# Used by AI agents to push changes. Do not commit real tokens.
GITHUB_PAT=YOUR_GITHUB_PAT
